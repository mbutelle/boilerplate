# Rendu au déploiement depuis les variables du coffre ansible-vault.
# Ne jamais committer de secret en clair : `make vault-edit` pour les modifier.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET={{ vault_app_secret }}

DATABASE_URL="{{ vault_database_url }}"
REDIS_URL={{ vault_redis_url }}
LOCK_DSN={{ vault_database_url }}

# auto_setup=1 : la table messenger_messages est créée au besoin.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1

MAILER_DSN={{ vault_mailer_dsn }}
SENDER_EMAIL={{ vault_sender_email }}

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE={{ vault_jwt_passphrase }}

CORS_ALLOW_ORIGIN='{{ cors_allow_origin }}'
BASE_URL={{ base_url }}
ADMIN_URL={{ admin_url }}
PASSWORD_RESET_URL={{ admin_url }}/auth/reset-password/%s
DOC_PASSWORD={{ vault_doc_password }}
