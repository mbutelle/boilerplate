# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=57c6a998e24998d627a9d23883c5072a
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://boilerplate:boilerplate@database:3306/boilerplate?serverVersion=8.0.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='*'
###< nelmio/cors-bundle ###

###> redis ###
REDIS_URL=redis://redis:6379
###< redis ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# auto_setup=1 : la table messenger_messages est créée au besoin. Elle était à 0
# et aucune migration ne la créait — le worker s'arrêtait sur « Table
# 'messenger_messages' doesn't exist ». Défaut invisible tant que rien ne
# consommait le transport.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

BASE_URL=http://api.boilerplate.localhost
ADMIN_URL=http://front.boilerplate.localhost

# Ces deux variables sont lues par les expéditeurs d'e-mails
# (#[Autowire('%env(SENDER_EMAIL)%')]). Elles étaient référencées sans être
# déclarées : tout envoi levait « Environment variable not found », donc aussi
# bien la création de compte que la réinitialisation de mot de passe.
SENDER_EMAIL=no-reply@boilerplate.localhost
# %s reçoit le jeton de réinitialisation.
PASSWORD_RESET_URL=http://front.boilerplate.localhost/auth/reset-password/%s

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=b5d09280aaa9c6a1a6fdcf258f79751c487448b43512aeb74847db0368e879f4
###< lexik/jwt-authentication-bundle ###

DOC_PASSWORD='$2y$13$CSKvEtJ6z3PnnBvA2bCKqeDwryiGqkK9euIB2BWz5GsR0orC07.JK'

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
#
# `flock` pose un verrou de fichier, donc LOCAL AU CONTENEUR : dès qu'il y a
# plusieurs répliques de l'api ou un worker séparé, chacune prend le sien et le
# verrou ne protège plus rien. On passe par la base, qui est le point commun de
# tous les processus.
LOCK_DSN=mysql://boilerplate:boilerplate@database:3306/boilerplate
###< symfony/lock ###
